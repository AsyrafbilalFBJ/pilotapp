# Port the API listens on.
PORT=3001

# The date the app treats as "today" (YYYY-MM-DD). The system clock is never used.
APP_TODAY=2026-05-15

# Folder with the seed JSON files, relative to the folder you start the app from.
DATASOURCE_DIR=src/datasource

# Secret used to sign JWTs. Required, at least 16 characters. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Token lifetime: seconds ("3600") or a duration ("15m", "12h", "1d").
JWT_EXPIRES_IN=1d

# Allowed browser origin(s) for CORS, comma-separated.
CORS_ORIGIN=http://localhost:3000

# Serve Swagger UI at /docs and the OpenAPI JSON at /docs-json ("true" or "false").
SWAGGER_ENABLED=true
